# ==============================================================================
# Miles Admin Hub API - Environment Configuration Template
# Copy this file to .env and replace placeholder values for your environment.
# ==============================================================================

# Server Environment & Port Binding
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miles_admin_dev?schema=public

# Security & Authentication (JWT)
# Minimum 16 characters required, 32+ characters recommended for production.
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=1d

# Allowed Cross-Origin Resource Sharing (CORS) Origins (Comma-separated)
# You may specify CORS_ORIGIN or FRONTEND_URL (both are supported)
CORS_ORIGIN=https://miles-flax.vercel.app
FRONTEND_URL=https://miles-flax.vercel.app

# Rate Limiting & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5

# API Documentation (Swagger)
# Set to 'false' in production; set to 'true' to enable /api/docs
SWAGGER_ENABLED=false

# Database Migration Strategy in Docker Container
# Set to 'true' to run pending migrations automatically upon container startup
RUN_MIGRATIONS=true
