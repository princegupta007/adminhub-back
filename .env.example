# Application Port
PORT=4000

# Environment Mode (development | production | test)
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miles_admin_dev?schema=public

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1d

# Allowed Frontend Origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000,https://miles-flax.vercel.app

# Throttler / Rate Limiting
# Window size in seconds
THROTTLE_TTL=60
# Max requests per window globally
THROTTLE_LIMIT=100
# Max requests per window on /auth/login
LOGIN_THROTTLE_LIMIT=5
